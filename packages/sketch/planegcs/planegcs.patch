+        // Extrudo: indices of the unknowns the last diagnosis found not fully
+        // constrained (FreeCAD's "dependent parameters"). With no driving
+        // constraint the diagnosis lists none, although every unknown is free.
+        vector<int> get_dependent_params()
+        {
+            VEC_pD dependent;
+            getDependentParams(dependent);
+            unordered_set<double *> loose(dependent.begin(), dependent.end());
+            bool all = dependent.empty() && dofsNumber() > 0;
+            vector<int> out;
+            for (int i = 0; i < p_params.size(); ++i)
+            {
+                if (!is_fixed[i] && (all || loose.count(p_params[i]) > 0))
+                {
+                    out.push_back(i);
+                }
+            }
+            return out;
+        }
