{
  "name": "extrudo",
  "private": true,
  "version": "0.4.1",
  "description": "Open-source, browser-based parametric CAD for the 3D-printing community.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm wasm && pnpm --filter @extrudo/web dev",
    "build": "pnpm wasm && pnpm --filter @extrudo/web build && pnpm --filter @extrudo/site build",
    "preview": "pnpm --filter @extrudo/web preview",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "lint": "biome check . && node scripts/check-boundaries.mjs && node scripts/check-licenses.mjs",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm wasm && pnpm typecheck && pnpm lint && pnpm occt check && pnpm test",
    "e2e": "pnpm build && playwright test",
    "e2e:install": "playwright install chromium",
    "demos": "node scripts/record-demos.mjs",
    "api:generate": "node --import ./scripts/ts-import.mjs scripts/generate-api.mjs",
    "docs:generate": "node --import ./scripts/ts-import.mjs scripts/generate-docs.mjs",
    "extrudo": "node packages/cli/bin/extrudo.mjs",
    "occt": "node packages/kernel/occt/occt.mjs",
    "wasm": "pnpm occt ensure && pnpm planegcs ensure && pnpm openscad ensure",
    "planegcs": "node packages/sketch/planegcs/planegcs.mjs",
    "openscad": "node packages/openscad/openscad.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
