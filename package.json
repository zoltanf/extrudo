{
  "name": "extrudo",
  "private": true,
  "version": "0.0.0",
  "description": "Open-source, browser-based parametric CAD for the 3D-printing community.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm occt ensure && pnpm --filter @extrudo/web dev",
    "build": "pnpm occt ensure && pnpm --filter @extrudo/web build",
    "preview": "pnpm --filter @extrudo/web preview",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "lint": "biome check . && node scripts/check-boundaries.mjs",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm occt ensure && pnpm typecheck && pnpm lint && pnpm occt check && pnpm test",
    "e2e": "pnpm build && playwright test",
    "e2e:install": "playwright install chromium",
    "occt": "node packages/kernel/occt/occt.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
